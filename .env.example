# Copy to .env (gitignored) and fill in real values for your machine.
# scripts/migrate.sh loads this automatically — only needed if your local
# Postgres differs from UserDbContextFactory's localhost/postgres/postgres default.
# Keep the quotes: migrate.sh sources this file with bash, and an unquoted ";"
# in the connection string is parsed as a command separator, silently truncating it.
USER_DB_CONNECTION_STRING="Host=localhost;Port=5432;Database=kart_user;Username=postgres;Password=postgres"
